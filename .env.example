# All variables are optional. There are no secrets and no API keys.
# Read in exactly one place: ownit/config.py (validated at startup).

# Interface the quiz server binds to.
OWNIT_HOST=127.0.0.1

# Port the quiz server listens on (0 = pick a free port).
OWNIT_PORT=8765

# Path of the saved-progress file. Leave unset to use <scanned root>/.ownit/state.json.
# OWNIT_STATE=/absolute/path/to/state.json
